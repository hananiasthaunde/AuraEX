{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/mcp", "destination": "/api/index.js" },
    { "source": "/.well-known/(.*)", "destination": "/api/index.js" }
  ]
}
